<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Coin Rush Arcade</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,Segoe UI,Arial,sans-serif;color:#fff;background:#050714}
body{background:radial-gradient(circle at 50% -15%,#263d86 0,#0b1230 38%,#04050d 100%)}
button{font:inherit;border:0;cursor:pointer}
.app{width:min(1120px,100%);margin:auto;padding:16px}
.topbar{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border:1px solid #ffffff1b;border-radius:18px;background:#ffffff0b;backdrop-filter:blur(12px)}
.logo{font-size:20px;font-weight:900;letter-spacing:1px}.logo em{font-size:9px;font-style:normal;background:#ffd447;color:#171208;padding:4px 6px;border-radius:5px;margin-left:5px}
.wallet{padding:9px 14px;border-radius:12px;background:#ffffff0c;color:#ffd447}
.screen{display:none;min-height:calc(100vh - 125px);place-items:center;padding:24px 0}.screen.active{display:grid}
.card{border:1px solid #ffffff1c;background:linear-gradient(145deg,#121b40f2,#091027f2);box-shadow:0 25px 80px #0009;border-radius:26px}
.hero{width:min(560px,94%);padding:38px 30px;text-align:center}
.hero-icon{font-size:76px;filter:drop-shadow(0 12px 20px #0008)}
.eyebrow{font-size:11px;color:#8190bd;letter-spacing:3px;font-weight:800;margin-top:4px}
h1{font-size:clamp(52px,10vw,82px);line-height:.95;margin:10px 0;background:linear-gradient(90deg,#fff,#ffd447);-webkit-background-clip:text;color:transparent}
h2{margin:0 0 8px;font-size:30px}.hero p,.muted{color:#a0acce;line-height:1.6}
.primary{width:100%;padding:15px 20px;border-radius:14px;background:linear-gradient(135deg,#ffe066,#ff9d1c);color:#181108;font-weight:950;font-size:16px;box-shadow:0 12px 30px #ffad3030}
.primary:hover{transform:translateY(-1px);filter:brightness(1.06)}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.actions button,.toggles button,.back,.game-controls button,.modal button:not(.primary){padding:12px;border-radius:12px;background:#ffffff0b;border:1px solid #ffffff16;color:#fff}
.toggles{display:flex;gap:8px;justify-content:center;margin-top:12px}.toggles button{font-size:12px}
.best{margin-top:20px;color:#8995b8;font-size:13px}.best b{color:#fff}
.panel{width:min(820px,95%);padding:30px;text-align:center}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
.item{padding:20px 14px;border-radius:18px;background:#ffffff08;border:1px solid #ffffff13}.item.selected{border-color:#ffd447;box-shadow:0 0 0 1px #ffd44755 inset}
.avatar{font-size:56px}.item h3{margin:8px 0 4px}.item p{margin:0 0 12px;color:#8995b9;font-size:12px}.item button{padding:9px 15px;border-radius:10px;background:#ffd447;color:#171208;font-weight:900}
.back{width:180px}
.game-screen{display:none}.game-screen.active{display:grid}
.game-box{width:min(900px,100%);position:relative;border-radius:22px;overflow:hidden;border:1px solid #ffffff20;box-shadow:0 30px 80px #000a;background:#050817}
canvas{display:block;width:100%;height:auto;touch-action:none}
.hud{position:absolute;z-index:3;top:0;left:0;right:0;display:flex;justify-content:space-around;padding:12px;background:#050817c4;font-size:13px}.hud b{color:#ffd447;margin-left:4px}
.game-controls{position:absolute;z-index:3;right:10px;bottom:10px;display:flex;gap:7px}.game-controls button{padding:8px 11px;background:#07102bd9}
.overlay{position:absolute;inset:0;z-index:10;display:grid;place-items:center;background:#030615e5}.overlay.hidden{display:none}
.modal{width:min(390px,88%);padding:30px;text-align:center}.level-badge{display:inline-block;padding:6px 12px;border-radius:99px;background:#ffd447;color:#171208;font-weight:900;font-size:12px}.modal button{display:block;width:100%;margin-top:10px}.big-icon{font-size:58px}
.tip{text-align:center;color:#69759a;font-size:12px}footer{text-align:center;color:#606b8e;font-size:11px;padding:5px 0 14px}
@media(max-width:650px){.app{padding:9px}.topbar{height:56px}.logo{font-size:16px}.grid{grid-template-columns:1fr 1fr}.hero{padding:30px 20px}.hero-icon{font-size:60px}.actions{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<header class="topbar"><div class="logo">🪙 COIN RUSH <em>ARCADE</em></div><div class="wallet">🪙 <b id="wallet">0</b></div></header>

<section id="home" class="screen active">
<div class="hero card">
<div class="hero-icon">🚀</div><div class="eyebrow">HTML5 ARCADE</div><h1>Coin Rush</h1>
<p>Collect coins. Grab gems. Dodge bombs. Beat your high score.</p>
<button class="primary" id="play">▶ PLAY NOW</button>
<div class="actions"><button id="chars">👤 Characters</button><button id="shop">🛒 Shop</button></div>
<div class="toggles"><button id="sound">🔊 Sound ON</button><button id="music">🎵 Music ON</button></div>
<div class="best">🏆 Best Score <b id="homeBest">0</b></div>
</div>
</section>

<section id="characterScreen" class="screen"><div class="panel card"><h2>Choose Your Runner</h2><p class="muted">Each character has a different speed.</p><div id="characterGrid" class="grid"></div><button class="back" data-home>← Back</button></div></section>

<section id="shopScreen" class="screen"><div class="panel card"><h2>Power Shop</h2><p class="muted">Buy upgrades with collected coins.</p><div id="shopGrid" class="grid"></div><button class="back" data-home>← Back</button></div></section>

<section id="gameScreen" class="screen game-screen">
<div><div class="game-box">
<div class="hud"><span>Score <b id="score">0</b></span><span>Level <b id="level">1</b></span><span>❤️ <b id="lives">3</b></span><span>🏆 <b id="gameBest">0</b></span></div>
<canvas id="canvas" width="900" height="560"></canvas>
<div class="game-controls"><button id="pause">Ⅱ Pause</button><button id="quit">✕ Quit</button></div>
<div id="pauseOverlay" class="overlay hidden"><div class="modal card"><h2>Game Paused</h2><button class="primary" id="resume">▶ Resume</button><button id="pauseQuit">Quit to Menu</button></div></div>

<div id="levelOverlay" class="overlay hidden">
  <div class="modal card">
    <div class="big-icon">🚀</div>
    <h2 id="levelTitle">Level 2 Unlocked!</h2>
    <p id="levelMessage">The next level is faster and harder.</p>
    <button class="primary" id="continueLevel">▶ Continue</button>
  </div>
</div>
<div id="overOverlay" class="overlay hidden"><div class="modal card"><div class="big-icon">🏆</div><h2>Game Over</h2><p>Score: <b id="finalScore">0</b></p><p>Coins earned: <b id="finalCoins">0</b></p><button class="primary" id="again">↻ Play Again</button><button id="menu">⌂ Main Menu</button></div></div>
</div><p class="tip">Desktop: A/D or ←/→ &nbsp; • &nbsp; Mobile: drag on the game</p></div>
</section>
<footer>Coin Rush • Complete Edition • Works offline</footer>
</div>

<script>
const $=id=>document.getElementById(id);
const C=$("canvas"),ctx=C.getContext("2d"),W=900,H=560;
const get=(k,d)=>localStorage.getItem(k)==null?d:JSON.parse(localStorage.getItem(k));
const put=(k,v)=>localStorage.setItem(k,JSON.stringify(v));
let coins=get("cr_coins",0),best=get("cr_best",0),char=get("cr_char",0);
let up=get("cr_up",{speed:0,life:0,magnet:0});
let sound=get("cr_sound",true),music=get("cr_music",true);
const chars=[["🚀","Rocket","Balanced",520],["🛸","UFO","Fast",590],["🏎️","Racer","Very Fast",650]];
const shop=[["speed","⚡","Speed Boost","Move faster",100],["life","❤️","Extra Life","Start with +1 life",150],["magnet","🧲","Coin Magnet","Pull nearby coins",200]];
/* ===== FREE BUILT-IN AUDIO (Web Audio API) ===== */
let audioCtx=null, masterGain=null, musicTimer=null, musicStep=0;
function initAudio(){
  if(!sound && !music) return;
  if(!audioCtx){
    const AC=window.AudioContext||window.webkitAudioContext;
    if(!AC)return;
    audioCtx=new AC();
    masterGain=audioCtx.createGain();
    masterGain.gain.value=.22;
    masterGain.connect(audioCtx.destination);
  }
  if(audioCtx.state==="suspended") audioCtx.resume();
  if(music && !musicTimer) startMusic();
}
function tone(freq,dur=.08,type="sine",vol=.06,when=0){
  if(!sound || !audioCtx || !masterGain)return;
  const o=audioCtx.createOscillator(),g=audioCtx.createGain();
  o.type=type;o.frequency.value=freq;
  g.gain.setValueAtTime(.0001,audioCtx.currentTime+when);
  g.gain.exponentialRampToValueAtTime(Math.max(.0001,vol),audioCtx.currentTime+when+.008);
  g.gain.exponentialRampToValueAtTime(.0001,audioCtx.currentTime+when+dur);
  o.connect(g);g.connect(masterGain);o.start(audioCtx.currentTime+when);o.stop(audioCtx.currentTime+when+dur+.02);
}
function sfxCoin(){tone(880,.07,"square",.045);tone(1320,.11,"sine",.035,.045)}
function sfxGem(){tone(660,.08,"triangle",.05);tone(990,.08,"triangle",.045,.06);tone(1320,.14,"sine",.04,.12)}
function sfxBomb(){tone(120,.18,"sawtooth",.08);tone(70,.24,"square",.055,.08)}
function sfxLevel(){[523,659,784,1047].forEach((n,i)=>tone(n,.14,"triangle",.05,i*.09))}
function sfxClick(){tone(500,.05,"square",.025)}
function sfxGameOver(){[392,330,262,196].forEach((n,i)=>tone(n,.22,"sawtooth",.045,i*.13))}
function startMusic(){
  if(!music || !audioCtx || musicTimer)return;
  const notes=[261.63,329.63,392,329.63,293.66,349.23,440,349.23];
  musicTimer=setInterval(()=>{
    if(!music||!audioCtx)return;
    tone(notes[musicStep%notes.length],.16,"sine",.012);
    musicStep++;
  },260);
}
function stopMusic(){if(musicTimer){clearInterval(musicTimer);musicTimer=null}}
function audioUserStart(){initAudio();sfxClick()}

function wallet(){put("cr_coins",coins);$("wallet").textContent=coins}
function show(id){document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));$(id).classList.add("active")}
function charUI(){$("characterGrid").innerHTML=chars.map((a,i)=>`<div class="item ${i==char?"selected":""}"><div class="avatar">${a[0]}</div><h3>${a[1]}</h3><p>${a[2]}</p><button onclick="pick(${i})">${i==char?"SELECTED":"SELECT"}</button></div>`).join("")}
window.pick=i=>{audioUserStart();char=i;put("cr_char",i);charUI()}
function shopUI(){$("shopGrid").innerHTML=shop.map(a=>`<div class="item"><div class="avatar">${a[1]}</div><h3>${a[2]}</h3><p>${a[3]}<br><b>${a[4]} coins</b></p><button onclick="buy('${a[0]}')">BUY</button></div>`).join("")}
window.buy=k=>{audioUserStart();let a=shop.find(x=>x[0]==k);if(coins<a[4])return alert("Not enough coins.");coins-=a[4];up[k]++;put("cr_up",up);wallet();shopUI()}
function toggles(){$("sound").textContent=(sound?"🔊":"🔇")+" Sound "+(sound?"ON":"OFF");$("music").textContent=(music?"🎵":"🔇")+" Music "+(music?"ON":"OFF")}
$("play").onclick=()=>{audioUserStart();start()};$("chars").onclick=()=>{audioUserStart();charUI();show("characterScreen")};$("shop").onclick=()=>{audioUserStart();shopUI();show("shopScreen")};
document.querySelectorAll("[data-home]").forEach(b=>b.onclick=()=>show("home"));
$("sound").onclick=()=>{sound=!sound;put("cr_sound",sound);toggles();if(sound){initAudio();sfxClick()}else{}};$("music").onclick=()=>{music=!music;put("cr_music",music);toggles();if(music){initAudio();startMusic()}else stopMusic()};toggles();wallet();$("homeBest").textContent=best;$("gameBest").textContent=best;

let running=false,paused=false,score=0,lives=3,level=1,last=0,timer=0,earned=0,objs=[],parts=[];
let pendingLevel=0, levelTransition=false, levelStars=0;
const p={x:450,target:450,y:500,w:76,h:30},keys={};
addEventListener("keydown",e=>{keys[e.key.toLowerCase()]=1;if(e.key==="Escape"&&running)togglePause()});
addEventListener("keyup",e=>keys[e.key.toLowerCase()]=0);
C.addEventListener("pointermove",e=>{let r=C.getBoundingClientRect();p.target=Math.max(40,Math.min(860,(e.clientX-r.left)*W/r.width))});
function start(){initAudio();score=0;earned=0;level=1;lives=3+up.life;objs=[];parts=[];pendingLevel=0;levelTransition=false;levelStars=0;p.x=p.target=450;running=true;paused=false;$("score").textContent=0;$("level").textContent=1;$("lives").textContent=lives;$("pauseOverlay").classList.add("hidden");$("overOverlay").classList.add("hidden");$("levelOverlay").classList.add("hidden");show("gameScreen");last=performance.now();timer=.2;requestAnimationFrame(loop)}
function togglePause(){if(!running)return;paused=!paused;$("pauseOverlay").classList.toggle("hidden",!paused);if(!paused){last=performance.now();requestAnimationFrame(loop)}}
$("pause").onclick=()=>{audioUserStart();togglePause()};$("resume").onclick=()=>{audioUserStart();togglePause()};$("quit").onclick=menu;$("pauseQuit").onclick=menu;$("again").onclick=start;$("menu").onclick=menu;$("continueLevel").onclick=()=>{audioUserStart();continueLevel()};
function menu(){running=false;paused=false;levelTransition=false;show("home");$("homeBest").textContent=best}
function continueLevel(){
  levelTransition=false;
  $("levelOverlay").classList.add("hidden");
  last=performance.now();
  requestAnimationFrame(loop);
}
function spawn(){
 let r=Math.random(),type;
 if(level>=4 && r<.08) type="rocket";
 else if(r<Math.min(.20,.14+level*.01)) type="bomb";
 else if(r<.25) type="gem";
 else type="coin";
 objs.push({
   x:25+Math.random()*850,y:-35,
   r:type==="gem"?15:type==="rocket"?18:13,
   type,s:150+Math.random()*100+level*14,a:Math.random()*6.28
 });
}
function hit(o){let l=p.x-p.w/2,t=p.y-p.h/2,cx=Math.max(l,Math.min(o.x,l+p.w)),cy=Math.max(t,Math.min(o.y,t+p.h));return(o.x-cx)**2+(o.y-cy)**2<(o.r+3)**2}
function burst(x,y,t){for(let i=0;i<13;i++)parts.push({x,y,vx:(Math.random()-.5)*230,vy:(Math.random()-.8)*230,t:.55,type:t})}
function update(dt){
 let sp=chars[char][3]+up.speed*55;if(keys.a||keys.arrowleft)p.target-=sp*dt;if(keys.d||keys.arrowright)p.target+=sp*dt;p.target=Math.max(38,Math.min(862,p.target));p.x+=(p.target-p.x)*Math.min(1,dt*13);
 const reachedLevel=1+Math.floor(score/100);
if(reachedLevel>level && !levelTransition){
  level=reachedLevel;
  levelStars=Math.min(3,1+Math.floor(level/3));
  levelTransition=true;sfxLevel();
  $("levelTitle").textContent="Level "+level+" Unlocked!";
  $("levelMessage").textContent=
    level===2?"Enemies are faster now!":
    level===3?"New hazards are appearing!":
    level%3===0?"🔥 Challenge level! Survive the speed boost.":"Keep going — the difficulty is rising!";
  $("levelOverlay").classList.remove("hidden");
  $("level").textContent=level;
  return;
}
timer-=dt;if(timer<=0){spawn();timer=Math.max(.18,.72-level*.042)}
 for(let i=objs.length-1;i>=0;i--){let o=objs[i];o.y+=o.s*dt;o.a+=dt*3;if(up.magnet&&o.type==="coin"){let dx=p.x-o.x,dy=p.y-o.y,d=Math.hypot(dx,dy);if(d<150){o.x+=dx*dt*2.8;o.y+=dy*dt*2.8}}if(hit(o)){burst(o.x,o.y,o.type);if(o.type==="bomb"||o.type==="rocket"){sfxBomb();lives--;if(lives<=0){gameOver();return}}else{if(o.type==="gem")sfxGem();else sfxCoin();score+=o.type==="gem"?50:10;earned+=o.type==="gem"?5:1;coins+=o.type==="gem"?5:1;wallet()}objs.splice(i,1);$("score").textContent=score;$("level").textContent=level;$("lives").textContent=lives}else if(o.y>H+40)objs.splice(i,1)}
 for(let i=parts.length-1;i>=0;i--){let q=parts[i];q.x+=q.vx*dt;q.y+=q.vy*dt;q.vy+=350*dt;q.t-=dt;if(q.t<=0)parts.splice(i,1)}
}
function gameOver(){sfxGameOver();running=false;if(score>best){best=score;put("cr_best",best)}$("gameBest").textContent=best;$("homeBest").textContent=best;$("finalScore").textContent=score;$("finalCoins").textContent=earned;$("overOverlay").classList.remove("hidden")}
function draw(){
let g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#111d49");g.addColorStop(1,"#050718");ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
ctx.globalAlpha=.16;
if(level%4===2){ctx.fillStyle="#3d74ff";ctx.fillRect(0,0,W,H)}
if(level%4===3){ctx.fillStyle="#8c42ff";ctx.fillRect(0,0,W,H)}
if(level%4===0){ctx.fillStyle="#ff6a3d";ctx.fillRect(0,0,W,H)}
ctx.globalAlpha=1;
for(let i=0;i<75;i++){ctx.fillStyle="#ffffff35";ctx.fillRect((i*137)%W,(i*83+performance.now()*.012*(i%4+1))%H,1.5,1.5)}
for(let o of objs){ctx.save();ctx.translate(o.x,o.y);ctx.rotate(o.a);if(o.type==="coin"){ctx.fillStyle="#ffd447";ctx.beginPath();ctx.arc(0,0,13,0,7);ctx.fill();ctx.fillStyle="#805700";ctx.font="bold 15px Arial";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillText("$",0,1)}else if(o.type==="gem"){ctx.fillStyle="#54dcff";ctx.beginPath();ctx.moveTo(0,-16);ctx.lineTo(14,-3);ctx.lineTo(7,15);ctx.lineTo(-7,15);ctx.lineTo(-14,-3);ctx.closePath();ctx.fill()}else if(o.type==="rocket"){
ctx.fillStyle="#ff684d";ctx.beginPath();ctx.moveTo(0,-19);ctx.lineTo(11,8);ctx.lineTo(0,14);ctx.lineTo(-11,8);ctx.closePath();ctx.fill();
ctx.fillStyle="#ffd447";ctx.beginPath();ctx.moveTo(0,13);ctx.lineTo(5,23);ctx.lineTo(0,19);ctx.lineTo(-5,23);ctx.closePath();ctx.fill();
}else{ctx.fillStyle="#282b37";ctx.beginPath();ctx.arc(0,0,15,0,7);ctx.fill();ctx.strokeStyle="#ff6874";ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-9,-9);ctx.lineTo(9,9);ctx.moveTo(9,-9);ctx.lineTo(-9,9);ctx.stroke()}ctx.restore()}
ctx.save();ctx.translate(p.x,p.y);ctx.shadowColor="#39d9ff";ctx.shadowBlur=20;ctx.fillStyle=char==1?"#b77cff":char==2?"#ff6b4d":"#28caff";ctx.beginPath();ctx.roundRect(-38,-15,76,30,10);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle="#10254d";ctx.fillRect(-25,-8,50,10);ctx.fillStyle="#ffd447";ctx.beginPath();ctx.arc(0,7,7,0,7);ctx.fill();ctx.restore();
for(let q of parts){ctx.globalAlpha=Math.max(0,q.t*2);ctx.fillStyle=(q.type==="bomb"||q.type==="rocket")?"#ff5b68":"#ffd447";ctx.fillRect(q.x,q.y,4,4);ctx.globalAlpha=1}
}
function loop(now){if(!running||paused)return;let dt=Math.min(.035,(now-last)/1000);last=now;update(dt);draw();requestAnimationFrame(loop)}
draw();
</script>
</body>
</html>
